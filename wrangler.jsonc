{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lv-virtual-try-on",
  "main": "worker/src/index.ts",
  "account_id": "b488918bc7219ea254359bc5cc9611a1",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://augustzad.github.io"
  },
  "ratelimits": [
    {
      "name": "TRY_ON_RATE_LIMITER",
      "namespace_id": "2060905",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
